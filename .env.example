# ── LLM backbone (experiment fuel) ────────────────────────────
OPENAI_API_KEY=sk-...
# Default models: cheap one for dev, capable one for final runs
AGENT_MODEL_DEV=gpt-4.1-mini
AGENT_MODEL_FINAL=gpt-4.1

# ── Market data ───────────────────────────────────────────────
FINNHUB_API_KEY=...
# financial-datasets MCP server key, if used
FINANCIAL_DATASETS_API_KEY=...

# ── Observability: Langfuse CLOUD ─────────────────────────────
# Use Langfuse Cloud. Cost is covered by YC credits ($100/mo) — do NOT self-host.
# Get keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── News scraping (timestamped corpus, run once) ──────────────
FIRECRAWL_API_KEY=...

# ── Misc ──────────────────────────────────────────────────────
# Cache directory for market data / LLM responses (gitignored)
CACHE_DIR=./data/cache
# Set to 1 in dev to cache LLM responses by prompt hash (zero-cost re-runs)
LLM_CACHE=1
