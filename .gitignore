# Secrets
.env

# Data & caches (large, reproducible, not for git)
/data/
*.parquet
*.csv
!tests/**/*.csv          # keep small fixtures used by tests

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Experiment outputs (keep these reproducible via scripts/reproduce_all.py)
runs/
results/
*.log

# Thesis source is tracked; generated LaTeX build artefacts are not.
thesis/archive/
thesis/**/*.aux
thesis/**/*.bbl
thesis/**/*.bcf
thesis/**/*.blg
thesis/**/*.lof
thesis/**/*.lot
thesis/**/*.out
thesis/**/*.pdf
thesis/**/*.run.xml
thesis/**/*.toc
!thesis/results/
!thesis/results/numbers.tex

# OS / editor
.DS_Store
.idea/
.vscode/

# reference/ clones (read-only, not shipped)
reference/
