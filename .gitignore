# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Experiment outputs (keep these reproducible via scripts/reproduce_all.py)
runs/
results/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# reference/ clones (read-only, not shipped)
reference/
